generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String         @id @default(uuid())
  email                    String         @unique
  username                 String
  password                 String
  avatarUrl                String?
  createdAt                DateTime       @default(now())
  hashedRt                 String?
  folders                  Folder[]
  modules                  Module[]       @relation("OwnedModules")
  authoredModules          Module[]       @relation("AuthoredModules")
  pushTokens               PushToken[]
  pushNotificationsEnabled Boolean        @default(false)
  studyEvents              StudyEvent[]
  passwordReset            PasswordReset?
}

model PushToken {
  id        String   @id @default(uuid())
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(uuid())
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  modules Module[]
  tags    String[] @default([])

  @@index([userId, createdAt, id])
}

model Module {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isFavorite Boolean  @default(false)

  userId String
  user   User   @relation("OwnedModules", fields: [userId], references: [id], onDelete: Cascade)

  authorId       String?
  author         User?   @relation("AuthoredModules", fields: [authorId], references: [id], onDelete: SetNull)
  authorUsername String?

  folders    Folder[]
  flashcards Flashcard[]
  isPublic   Boolean     @default(false)

  @@index([userId, createdAt, id])
  @@index([userId, name, id])
  @@index([userId, updatedAt])
  @@index([isPublic, updatedAt, id])
  @@index([authorId])
}

enum CardStatus {
  UNSTUDIED
  STILL_LEARNING
  KNOWN
}

model Flashcard {
  id         String     @id @default(uuid())
  term       String
  definition String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  isStarred  Boolean    @default(false)
  status     CardStatus @default(UNSTUDIED)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@index([moduleId, status])
}

model StudyEvent {
  id            String     @id @default(uuid())
  clientEventId String
  status        CardStatus
  answeredAt    DateTime
  createdAt     DateTime   @default(now())

  flashcardId String
  moduleId    String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientEventId])
  @@index([userId, answeredAt])
  @@index([moduleId])
  @@index([flashcardId])
}
