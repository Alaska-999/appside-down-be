generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  username  String
  password  String
  avatarUrl String?
  createdAt DateTime @default(now())
  hashedRt  String?
  folders   Folder[]
  modules   Module[]
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  icon      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  modules Module[]
  tags    String[] @default([])
}

model Module {
  id         String   @id @default(uuid())
  name       String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isFavorite Boolean  @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  folders    Folder[]
  flashcards Flashcard[]
}

enum CardStatus {
  NEW
  LEARNING
  MASTERED
}

model Flashcard {
  id         String     @id @default(uuid())
  term       String
  definition String
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  isStarred  Boolean    @default(false)
  status     CardStatus @default(NEW)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id])
}
